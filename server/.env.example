PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
# Frontend URL(s) allowed by CORS, comma-separated
CLIENT_URL=http://localhost:5173
# Optional: only if your network blocks MongoDB SRV DNS lookups
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Optional: email a notification for each new enquiry via Resend (https://resend.com).
# Leave unset to only save enquiries in MongoDB. MAIL_FROM must use a domain verified in Resend.
# RESEND_API_KEY=
# MAIL_FROM="TechNova Website <no-reply@example.com>"
# ENQUIRY_EMAIL_TO=sales@example.com

# Admin login (/admin). At least 32 random characters, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs out the admin. Create the admin with: npm run create-admin
# ADMIN_AUTH_SECRET=
# Production only: same value on Render and Vercel (Vercel adds it to /api/admin requests).
# Locks the admin API to the Vercel proxy and lets login rate limits see the visitor IP.
# Leave unset locally.
# ADMIN_PROXY_SECRET=
# Optional default email for npm run create-admin (the password is always typed in, never stored)
# ADMIN_EMAIL=
